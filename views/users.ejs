<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
</head>
<body>

    <h1>User List</h1>

    <% if (users.length === 0) { %>

        <p>No users found.</p>

    <% } else { %>

        <ol>
            <% users.forEach(user => { %>

                <li>
                    <strong><%= user.name %></strong>
                    - <%= user.email %>
                    - <%= user.age %> years
                </li>

            <% }); %>
        </ol>

        <p>Total users: <%= users.length %></p>

    <% } %>

    <br>

    <a href="/register">Go to Registration</a>

</body>
</html>